rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
        'uid',
        'displayName',
        'email',
        'communityConnected',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'uid',
        'displayName',
        'email',
        'photoURL',
        'communityConnected',
        'createdAt',
        'updatedAt'
      ]) &&
      data.uid is string &&
      data.uid == userId &&
      data.uid == request.auth.uid &&
      isValidId(data.uid) &&
      data.displayName is string &&
      data.displayName.size() <= 120 &&
      data.email is string &&
      data.email.size() <= 200 &&
      (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
      data.communityConnected is bool &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidGenerationRecord(data) {
      return data.keys().hasAll([
        'ownerId',
        'mode',
        'model',
        'text',
        'style',
        'voiceName',
        'durationSeconds',
        'byteLength',
        'createdAt'
      ]) &&
      data.keys().hasOnly([
        'ownerId',
        'mode',
        'model',
        'text',
        'style',
        'voiceName',
        'emphasizedWords',
        'durationSeconds',
        'byteLength',
        'createdAt'
      ]) &&
      data.ownerId is string &&
      data.ownerId == request.auth.uid &&
      isValidId(data.ownerId) &&
      data.mode is string &&
      data.mode in ['single', 'dialogue'] &&
      data.model is string &&
      data.model in ['gemini-3.8-flash-tts', 'gemini-3.8-flash-lite-tts'] &&
      data.text is string &&
      data.text.size() >= 1 &&
      data.text.size() <= 4000 &&
      data.style is string &&
      data.style.size() <= 1000 &&
      data.voiceName is string &&
      data.voiceName.size() >= 1 &&
      data.voiceName.size() <= 80 &&
      (!('emphasizedWords' in data) || (
        data.emphasizedWords is list &&
        data.emphasizedWords.size() <= 30 &&
        (data.emphasizedWords.size() == 0 || data.emphasizedWords[0] is string)
      )) &&
      data.durationSeconds is number &&
      data.durationSeconds >= 0 &&
      data.byteLength is number &&
      data.byteLength >= 0 &&
      data.createdAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId) &&
        isOwner(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(userId) &&
        isOwner(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'photoURL',
          'communityConnected',
          'updatedAt'
        ]);
      allow delete: if false;
    }

    match /generations/{generationId} {
      allow get: if isValidId(generationId) &&
        isSignedIn() &&
        existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() &&
        resource.data.ownerId == request.auth.uid;
      allow create: if isValidId(generationId) &&
        isSignedIn() &&
        isValidGenerationRecord(incoming()) &&
        incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(generationId) &&
        isSignedIn() &&
        existing().ownerId == request.auth.uid;
    }
  }
}
