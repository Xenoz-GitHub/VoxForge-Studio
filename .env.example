# VoxForge Studio environment configuration
#
# IMPORTANT: API keys are supplied by the user through the in-app "API Keys" panel.
# The variables below are OPTIONAL server-side fallbacks for deployments that want
# a working pool out of the box (e.g. a demo instance).
#
# Keys sent from the browser take precedence over these fallbacks.

# Single fallback key
GEMINI_API_KEY=""

# Optional comma/space/semicolon-separated fallback keys
GEMINI_API_KEYS=""

# Optional numbered fallback keys (GEMINI_API_KEY_1 .. GEMINI_API_KEY_20)
# GEMINI_API_KEY_1=""

# Server port (default 3000)
PORT=3000

# Set to "production" for hardened mode: strict HSTS, generic error messages,
# and static serving from dist/. Run `npm run build` first.
NODE_ENV=development
